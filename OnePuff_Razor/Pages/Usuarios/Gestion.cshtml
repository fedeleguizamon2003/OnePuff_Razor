@page
@model OnePuff_Razor.Pages.Usuarios.GestionModel
@{
    ViewData["Title"] = "Gestión de Usuarios";
    Layout = "_Layout";
}

<h2 class="mb-4">👑 Gestión de Usuarios</h2>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-info">
        @TempData["Msg"]
    </div>
}

<div class="mb-3">
    <a asp-page="/Usuarios/NuevoAdmin" class="btn btn-success">
        ➕ Crear nuevo administrador
    </a>
</div>

<hr />

<h4>🛡 Administradores</h4>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Email</th>
            <th>DNI</th>
            <th style="width:160px;" class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model.Admins)
        {
            <tr>
                <td>@u.UsuarioId</td>
                <td>@u.Nombre @u.Apellido</td>
                <td>@u.Email</td>
                <td>@u.Dni</td>
                <td class="text-center">
                    @if (u.Email != "calopez@iiconcepcion.edu.ar")
                    {
                        <form method="post" asp-page-handler="Eliminar" asp-route-id="@u.UsuarioId"
                              onsubmit="return confirm('¿Eliminar al administrador @u.Email ?');">
                            <button class="btn btn-sm btn-danger">Eliminar</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted">Master admin</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<hr />

<h4>👥 Clientes</h4>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Email</th>
            <th>DNI</th>
            <th style="width:160px;" class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model.Clientes)
        {
            <tr>
                <td>@u.UsuarioId</td>
                <td>@u.Nombre @u.Apellido</td>
                <td>@u.Email</td>
                <td>@u.Dni</td>
                <td class="text-center">
                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@u.UsuarioId"
                          onsubmit="return confirm('¿Eliminar al cliente @u.Email ?');">
                        <button class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
