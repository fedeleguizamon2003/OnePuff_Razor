@page
@model OnePuff_Razor.Pages.Usuarios.RegisterModel
@{
    ViewData["Title"] = "Registro de Usuario";
    Layout = "_Layout";
}

<h1 class="mb-4">🧍 Registro de Usuario</h1>

<form method="post" class="border p-4 rounded shadow-sm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- Datos personales -->
    <div class="row mb-3">
        <div class="col-md-6">
            <label>Nombre</label>
            <input asp-for="Usuario.Nombre" class="form-control" />
            <span asp-validation-for="Usuario.Nombre" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label>Apellido</label>
            <input asp-for="Usuario.Apellido" class="form-control" />
            <span asp-validation-for="Usuario.Apellido" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label>Email</label>
            <input asp-for="Usuario.Email" type="email" class="form-control" />
            <span asp-validation-for="Usuario.Email" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label>DNI</label>
            <input asp-for="Usuario.Dni" class="form-control" />
            <span asp-validation-for="Usuario.Dni" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label>Contraseña</label>
        <!-- OJO: bindea al string Password del PageModel, no a Usuario.PasswordHash -->
        <input asp-for="Password" class="form-control" type="password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    @* Rol oculto: siempre Cliente en registro público *@
    <input type="hidden" asp-for="Usuario.Rol" value="Cliente" />


    <!-- Dirección  -->
    <div id="direccionFields" class="border-top pt-3">
        <h5>Dirección (solo clientes)</h5>
        <div class="row">
            <div class="col-md-4">
                <label>Calle</label>
                <input asp-for="Direccion.Calle" class="form-control" />
                <span asp-validation-for="Direccion.Calle" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label>Altura</label>
                <input asp-for="Direccion.Altura" class="form-control" />
                <span asp-validation-for="Direccion.Altura" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label>Localidad</label>
                <input asp-for="Direccion.Localidad" class="form-control" />
                <span asp-validation-for="Direccion.Localidad" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="mt-4 text-center">
        <button type="submit" class="btn btn-success">Registrarme</button>
        <a asp-page="/Usuarios/Login" class="btn btn-link">Ya tengo cuenta</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Mostrar/ocultar dirección según rol
        const rolSelect = document.querySelector('select[name="Usuario.Rol"]');
        const direccionFields = document.getElementById('direccionFields');

        function toggleDireccion() {
            direccionFields.style.display = rolSelect.value === 'Cliente' ? 'block' : 'none';
        }

        rolSelect.addEventListener('change', toggleDireccion);
        toggleDireccion();
    </script>
}
