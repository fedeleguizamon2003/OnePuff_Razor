@page
@model OnePuff_Razor.Pages.Carrito.ResumenModel
@{
    Layout = null;  // 🔹 Importante: no usamos el layout principal, es un fragmento
}

@if (Model.CarritoActual.Items.Any())
{
    <table class="table table-striped align-middle">
        <thead class="table-light">
            <tr>
                <th>Producto</th>
                <th class="text-center">Cantidad</th>
                <th class="text-end">Precio</th>
                <th class="text-end">Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.CarritoActual.Items)
            {
                <tr>
                    <td>@item.Producto.Nombre</td>
                    <td class="text-center">@item.Cantidad</td>
                    <td class="text-end">$@item.PrecioUnitarioSnapshot.ToString("N2")</td>
                    <td class="text-end">$@(item.PrecioUnitarioSnapshot* item.Cantidad).ToString("N2")</td>
                    <td class="text-end">
                        <form method="post" asp-page="/Carrito/Index" asp-page-handler="Eliminar" asp-route-productoId="@item.ProductoId">
                            <button type="submit" class="btn btn-sm btn-outline-danger">🗑</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-end mt-3">
        <h5>Total: 💲@Model.CarritoActual.Items.Sum(i => i.PrecioUnitarioSnapshot * i.Cantidad).ToString("N2")</h5>
    </div>
}
else
{
    <div class="text-center text-muted py-3">
        <p>Tu carrito está vacío 🛒</p>
    </div>
}
