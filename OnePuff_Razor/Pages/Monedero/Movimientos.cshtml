@page
@model OnePuff_Razor.Pages.Monedero.MovimientosModel
@{
    ViewData["Title"] = "Movimientos del monedero";
    Layout = "_Layout";
}

<h2 class="my-3">📒 Movimientos del monedero</h2>

<div class="row g-3 mb-3">
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Saldo</h5>
                    <span class="badge bg-success">Disponible</span>
                </div>
                <p class="display-6 text-success mb-0">$ @Model.SaldoActual.ToString("N2")</p>
            </div>
        </div>
    </div>
</div>

<form method="get" class="row gy-2 gx-3 align-items-end mb-4 bg-light p-3 rounded">
    <div class="col-md-3">
        <label class="form-label">Desde</label>
        <input type="date" name="Desde" value="@(Model.Desde?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Hasta</label>
        <input type="date" name="Hasta" value="@(Model.Hasta?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Tipo</label>
        <select name="Tipo" class="form-select">
            <option value="">Todos</option>
            <option value="Recarga" selected="@(Model.Tipo == "Recarga")">Recarga</option>
            <option value="DebitoCompra" selected="@(Model.Tipo == "DebitoCompra")">Débito por compra</option>
            <option value="Ajuste" selected="@(Model.Tipo == "Ajuste")">Ajuste</option>
        </select>
    </div>
    <div class="col-md-3 text-end">
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a asp-page="/Monedero/Movimientos" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

@if (Model.Movimientos.Any())
{
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Fecha</th>
                <th>Tipo</th>
                <th class="text-end">Monto</th>
                <th>Descripción</th>
                <th>Pedido</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model.Movimientos)
            {
                <tr>
                    <td>@m.Fecha.ToString("g")</td>
                    <td>
                        @if (m.Tipo == "Recarga")
                        {
                            <span class="badge bg-success">Recarga</span>
                        }
                        else if (m.Tipo == "DebitoCompra")
                        {

                            <span class="badge bg-danger">Débito compra</span>
                        }
                        else
                        {

                            <span class="badge bg-secondary">@m.Tipo</span>
                        }
                    </td>
                    <td class="text-end">$ @m.Monto.ToString("N2")</td>
                    <td>@(string.IsNullOrWhiteSpace(m.Descripcion) ? "-" : m.Descripcion)</td>
                    <td>
                        @if (m.PedidoId.HasValue)
                        {
                            <a asp-page="/Pedidos/Detalle" asp-route-id="@m.PedidoId.Value" class="btn btn-sm btn-outline-primary">Ver pedido</a>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No hay movimientos con los filtros aplicados.</div>
}

<div class="mt-3">
    <a asp-page="/Monedero/Recarga" class="btn btn-success">Cargar saldo</a>
</div>
