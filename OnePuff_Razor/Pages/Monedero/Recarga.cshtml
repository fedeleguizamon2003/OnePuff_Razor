@page
@model OnePuff_Razor.Pages.Monedero.RecargaModel
@{
    ViewData["Title"] = "Recargar monedero";
    Layout = "_Layout";
}

<h2 class="my-3">💳 Recargar monedero</h2>

@if (TempData["Ok"] is string ok && !string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
{
    <div class="alert alert-danger">@err</div>
}

<div class="row">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Saldo actual</h5>
                <p class="display-6 text-success">$ @Model.SaldoActual.ToString("N2")</p>
                <p class="text-muted">Este es tu saldo disponible para pagar compras.</p>
            </div>
        </div>
    </div>
</div>

<hr class="my-4" />

<div class="row">
    <div class="col-lg-6">
        <form method="post" class="border rounded p-3 bg-light">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label class="form-label">Monto a recargar ($)</label>
                <input asp-for="Monto" class="form-control" type="number" step="0.01" min="1" placeholder="Ej: 2000" />
                <span asp-validation-for="Monto" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Número de tarjeta (16 dígitos)</label>
                <input asp-for="Numero" class="form-control" placeholder="1111222233334444" pattern="\d{16}" />
                <span class="form-text">Solo validación ficticia, no se usa pasarela real.</span>
                <span asp-validation-for="Numero" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label class="form-label">Vencimiento (MM/AA)</label>
                    <input asp-for="Vencimiento" class="form-control" placeholder="12/29" pattern="(0[1-9]|1[0-2])\/\d{2}" />
                    <span asp-validation-for="Vencimiento" class="text-danger"></span>
                </div>
                <div class="col-6 mb-3">
                    <label class="form-label">CVV</label>
                    <input asp-for="Cvv" class="form-control" placeholder="123" pattern="\d{3}" />
                    <span asp-validation-for="Cvv" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Nombre en la tarjeta</label>
                <input asp-for="Nombre" class="form-control" placeholder="Nombre y Apellido" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Recargar</button>
                <a asp-page="/Monedero/Movimientos" class="btn btn-outline-secondary">Ver movimientos</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
