@* ===========================================================
   🔹 LAYOUT PRINCIPAL DEL SITIO (OnePuff_Razor)
   Controla el encabezado, navegación, cuerpo y footer global.
   Muestra el menú dinámico según si hay sesión y el rol del usuario.
   =========================================================== *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OnePuff_Razor</title>

    <!-- 🔹 Estilos base -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OnePuff_Razor.styles.css" asp-append-version="true" />

    <!-- 🔹 Bootstrap Icons (para íconos como bi-check-circle-fill, bi-slash-circle-fill, etc.) -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <!-- 🔹 Logo / título del sitio -->
                <a class="navbar-brand" asp-area="" asp-page="/Index">OnePuff_Razor</a>

                <!-- 🔹 Botón hamburguesa (modo responsive) -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!-- 🔹 Sección izquierda del navbar -->
                    <ul class="navbar-nav flex-grow-1">
                        <!-- Opción visible para todos -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Inicio</a>
                        </li>

                        @* ======================================================
                           🔹 Menú dinámico: cambia según sesión y rol del usuario
                           ====================================================== *@

                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            var rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

                            if (rol == "Administrador")
                            {
                                <!-- 🔸 Si es ADMIN → acceso al panel de gestión -->
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/Productos/Admin">Gestión de Productos</a>
                                </li>
                            }
                            else if (rol == "Cliente")
                            {
                                <!-- 🔸 Si es CLIENTE → acceso al catálogo -->
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/Productos/Cliente">Productos</a>
                                </li>
                            }
                        }
                        else
                        {
                            <!-- 🔸 Usuario no autenticado → redirige al login -->
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Usuarios/Login">Productos</a>
                            </li>
                        }
                    </ul>

                    @* ======================================================
                       🔹 Sección derecha del navbar (sesión de usuario)
                       ====================================================== *@
                    <div class="d-flex align-items-center">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <!-- 👤 Mostrar nombre y rol del usuario actual -->
                            <span class="me-2">
                                👤 @User.Identity.Name
                                (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)
                            </span>

                            <!-- 🚪 Botón para cerrar sesión -->
                            <a asp-page="/Usuarios/Logout" class="btn btn-outline-danger btn-sm">
                                Cerrar sesión
                            </a>
                        }
                        else
                        {
                            <!-- 🔐 Botón para iniciar sesión -->
                            <a asp-page="/Usuarios/Login" class="btn btn-outline-primary btn-sm">
                                Iniciar sesión
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- 🔹 Contenedor principal donde se carga el contenido de cada página -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- 🔹 Footer global -->
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - OnePuff_Razor -
            <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <!-- 🔹 Scripts base (jQuery, Bootstrap, JS del sitio) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Permite incluir scripts adicionales desde páginas individuales *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
