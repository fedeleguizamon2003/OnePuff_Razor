@page
@model OnePuff_Razor.Pages.Pedidos.ClienteModel
@{
    ViewData["Title"] = "Mis pedidos";
    Layout = "_Layout";
}
<h3>Mis pedidos</h3>

@if (!Model.Pedidos.Any())
{
    <p class="text-muted">Aún no tenés pedidos.</p>
}
else
{
    <table class="table">
        <thead class="table-light">
            <tr><th>#</th><th>Fecha</th><th>Estado</th><th class="text-end">Total</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Pedidos)
            {
                <tr>
                    <td>@p.PedidoId</td>
                    <td>@p.FechaPedido:g</td>
                    <td>@p.Estado</td>
                    <td class="text-end">$ @p.Total.ToString("N2")</td>
                    <td><a asp-page="/Pedidos/Detalle" asp-route-id="@p.PedidoId" class="btn btn-sm btn-outline-primary">Ver</a></td>
                </tr>
            }
        </tbody>
    </table>
}
