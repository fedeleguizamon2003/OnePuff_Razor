@page
@model OnePuff_Razor.Pages.Productos.EditModel
@{
    ViewData["Title"] = "Editar producto";
    Layout = "_Layout";
}

<h2 class="mb-3">✏️ Editar producto</h2>

<form method="post" class="border p-3 rounded bg-light">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <input type="hidden" asp-for="Producto.ProductoId" />

    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input asp-for="Producto.Nombre" class="form-control" />
        <span asp-validation-for="Producto.Nombre" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Precio</label>
            <input asp-for="Producto.Precio" class="form-control" />
            <span asp-validation-for="Producto.Precio" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Peso (g)</label>
            <input asp-for="Producto.Peso" class="form-control" />
            <span asp-validation-for="Producto.Peso" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Stock</label>
            <input asp-for="Producto.Stock" class="form-control" />
            <span asp-validation-for="Producto.Stock" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Categoría</label>
        <select asp-for="Producto.CategoriaId" asp-items="Model.CategoriasSelectList" class="form-select"></select>
        <span asp-validation-for="Producto.CategoriaId" class="text-danger"></span>
    </div>

    <!-- 🖼️ Campo URL de Imagen con preview -->
    <div class="mb-3">
        <label class="form-label">URL de Imagen</label>
        <input asp-for="Producto.UrlImagen" class="form-control" placeholder="https://..." oninput="previewImagen(this.value)" />
        <span asp-validation-for="Producto.UrlImagen" class="text-danger"></span>
    </div>

    @if (!string.IsNullOrEmpty(Model.Producto.UrlImagen))
    {
        <div id="preview-container" class="text-center mb-3">
            <img id="preview-img" src="@Model.Producto.UrlImagen" class="img-thumbnail" style="max-width:200px;" alt="Vista previa" />
        </div>
    }
    else
    {
        <div id="preview-container" class="text-center mb-3 d-none">
            <img id="preview-img" src="" class="img-thumbnail" style="max-width:200px;" alt="Vista previa" />
        </div>
    }

    <div class="form-check mb-3">
        <input class="form-check-input" asp-for="Producto.EstaActivo" />
        <label class="form-check-label" asp-for="Producto.EstaActivo">Activo</label>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-page="/Productos/Admin" class="btn btn-secondary">Volver</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImagen(url) {
            const img = document.getElementById('preview-img');
            const container = document.getElementById('preview-container');
            if (url && url.startsWith('http')) {
                img.src = url;
                container.classList.remove('d-none');
            } else {
                container.classList.add('d-none');
            }
        }
    </script>
}
