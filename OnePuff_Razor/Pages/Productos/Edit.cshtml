@page
@model OnePuff_Razor.Pages.Productos.EditModel

@{
    ViewData["Title"] = "Editar Producto";
    Layout = "_Layout";
}

<h1>Editar producto</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <!-- Formulario que envía al método OnPostAsync -->
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Campo oculto con el ID del producto -->
            <input type="hidden" asp-for="Producto.ProductoId" />

            <!-- Campo: Nombre -->
            <div class="form-group">
                <label asp-for="Producto.Nombre" class="control-label">Nombre</label>
                <input asp-for="Producto.Nombre" class="form-control" />
                <span asp-validation-for="Producto.Nombre" class="text-danger"></span>
            </div>

            <!-- Campo: Precio -->
            <div class="form-group">
                <label asp-for="Producto.Precio" class="control-label">Precio</label>
                <input asp-for="Producto.Precio" class="form-control" />
                <span asp-validation-for="Producto.Precio" class="text-danger"></span>
            </div>

            <!-- Campo: Peso -->
            <div class="form-group">
                <label asp-for="Producto.Peso" class="control-label">Peso (gramos)</label>
                <input asp-for="Producto.Peso" class="form-control" />
                <span asp-validation-for="Producto.Peso" class="text-danger"></span>
            </div>

            <!-- Campo: URL Imagen -->
            <div class="form-group">
                <label asp-for="Producto.UrlImagen" class="control-label">URL Imagen</label>
                <input asp-for="Producto.UrlImagen" class="form-control" />
                <span asp-validation-for="Producto.UrlImagen" class="text-danger"></span>
            </div>

            <!-- Campo: Stock -->
            <div class="form-group">
                <label asp-for="Producto.Stock" class="control-label">Stock</label>
                <input asp-for="Producto.Stock" class="form-control" />
                <span asp-validation-for="Producto.Stock" class="text-danger"></span>
            </div>

            <!-- Campo: Activo -->
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Producto.EstaActivo" />
                    @Html.DisplayNameFor(model => model.Producto.EstaActivo)
                </label>
            </div>

            <!-- Campo: Categoría -->
            <div class="form-group">
                <label asp-for="Producto.CategoriaId" class="control-label">Categoría</label>

                <!-- Combo dinámico -->
                <select asp-for="Producto.CategoriaId"
                        class="form-control"
                        asp-items="Model.CategoriasLista">
                    <option value="">-- Selecciona una categoría --</option>
                </select>

                <span asp-validation-for="Producto.CategoriaId" class="text-danger"></span>
            </div>

            <!-- Botones -->
            <div class="form-group mt-3">
                <input type="submit" value="Guardar cambios" class="btn btn-success" />
                <a asp-page="Index" class="btn btn-secondary">Volver al listado</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
