@page
@model OnePuff_Razor.Pages.Productos.CreateModel
@{
    ViewData["Title"] = "Crear producto";
    Layout = "_Layout";
}

<h2 class="mb-3">➕ Crear producto</h2>

<form method="post" class="border p-3 rounded bg-light">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input asp-for="Producto.Nombre" class="form-control" />
        <span asp-validation-for="Producto.Nombre" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Precio</label>
            <input asp-for="Producto.Precio" class="form-control" />
            <span asp-validation-for="Producto.Precio" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Peso (g)</label>
            <input asp-for="Producto.Peso" class="form-control" />
            <span asp-validation-for="Producto.Peso" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Stock</label>
            <input asp-for="Producto.Stock" class="form-control" />
            <span asp-validation-for="Producto.Stock" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Categoría</label>
        <!-- 🔹 OJO: asp-items usa Model.CategoriasSelectList -->
        <select asp-for="Producto.CategoriaId" asp-items="Model.CategoriasSelectList" class="form-select"></select>
        <span asp-validation-for="Producto.CategoriaId" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" asp-for="Producto.EstaActivo" />
        <label class="form-check-label" asp-for="Producto.EstaActivo">Activo</label>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">Guardar</button>
        <a asp-page="/Productos/Admin" class="btn btn-secondary">Volver</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
